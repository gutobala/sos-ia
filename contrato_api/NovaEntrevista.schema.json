{
  "$defs": {
    "DocumentoAnexado": {
      "additionalProperties": false,
      "description": "1.7.0: documento anexado ao pedido antes da análise. O texto é lido e entra na análise; o arquivo não é guardado.",
      "properties": {
        "nome": {
          "description": "nome do arquivo, como o usuário vê",
          "maxLength": 200,
          "title": "Nome",
          "type": "string"
        },
        "mime": {
          "description": "PDF, DOCX ou TXT; outros tipos: 422",
          "pattern": "^(application/pdf|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|text/plain)$",
          "title": "Mime",
          "type": "string"
        },
        "base64": {
          "description": "conteúdo em base64 (sem o prefixo data:); até 10 MB de arquivo",
          "maxLength": 14000000,
          "title": "Base64",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "mime",
        "base64"
      ],
      "title": "DocumentoAnexado",
      "type": "object"
    },
    "FontePontoPartida": {
      "enum": [
        "fgca",
        "livre",
        "forms",
        "benner",
        "hope",
        "agendamento",
        "wiki"
      ],
      "title": "FontePontoPartida",
      "type": "string"
    },
    "Imagem": {
      "additionalProperties": false,
      "properties": {
        "nome": {
          "maxLength": 200,
          "title": "Nome",
          "type": "string"
        },
        "mime": {
          "pattern": "^image/(png|jpeg|gif|bmp|webp)$",
          "title": "Mime",
          "type": "string"
        },
        "base64": {
          "description": "conteúdo da imagem em base64 (sem o prefixo data:)",
          "maxLength": 7000000,
          "title": "Base64",
          "type": "string"
        }
      },
      "required": [
        "nome",
        "mime",
        "base64"
      ],
      "title": "Imagem",
      "type": "object"
    },
    "Intencao": {
      "description": "Opção do cardápio escolhida pelo usuário (a garantia não passa pela IA).",
      "enum": [
        "PAROU_DE_FUNCIONAR",
        "MUDAR_EXISTENTE",
        "ALGO_NOVO"
      ],
      "title": "Intencao",
      "type": "string"
    },
    "PontoPartida": {
      "additionalProperties": false,
      "description": "Por onde o usuário entra no sistema (1.5.0). Entra na busca do RAG junto com o relato e preenche `onde_ocorre`\n(corretivo) ou `funcionalidade` (evolutivo existente), que deixam de ser perguntados; em \"algo novo\" é \"onde ficaria\".",
      "properties": {
        "caminho": {
          "description": "\"Cadastro > NUGIV > Parcelamento Resíduo\" ou o texto livre",
          "maxLength": 300,
          "minLength": 2,
          "title": "Caminho",
          "type": "string"
        },
        "detalhe": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detalhe"
        },
        "menu_id": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MenuItem.id (nulo em fonte livre)",
          "title": "Menu Id"
        },
        "fonte": {
          "$ref": "#/$defs/FontePontoPartida"
        }
      },
      "required": [
        "caminho",
        "fonte"
      ],
      "title": "PontoPartida",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cd_sistema": {
      "description": "CD_SISTEMA do SOS",
      "title": "Cd Sistema",
      "type": "integer"
    },
    "sigla": {
      "description": "sigla do sistema (ex.: GAI)",
      "maxLength": 40,
      "title": "Sigla",
      "type": "string"
    },
    "intencao": {
      "$ref": "#/$defs/Intencao"
    },
    "relato": {
      "description": "relato livre do usuário",
      "maxLength": 20000,
      "minLength": 10,
      "title": "Relato",
      "type": "string"
    },
    "imagens": {
      "items": {
        "$ref": "#/$defs/Imagem"
      },
      "maxItems": 5,
      "title": "Imagens",
      "type": "array"
    },
    "documentos": {
      "description": "1.7.0: PDF, DOCX e TXT anexados antes da análise; o texto entra no relato (anonimizado como o OCR das imagens)",
      "items": {
        "$ref": "#/$defs/DocumentoAnexado"
      },
      "maxItems": 3,
      "title": "Documentos",
      "type": "array"
    },
    "ponto_partida": {
      "anyOf": [
        {
          "$ref": "#/$defs/PontoPartida"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "1.5.0: com ele, não ponha mais 'Menu: …' no relato. 1.5.1: prefira pontos_partida; este vale como lista de 1"
    },
    "pontos_partida": {
      "description": "1.5.1: as telas por onde o usuário entra (até 5, na ordem em que ele escolheu); uma busca por ponto. Não mande junto com ponto_partida",
      "items": {
        "$ref": "#/$defs/PontoPartida"
      },
      "maxItems": 5,
      "title": "Pontos Partida",
      "type": "array"
    }
  },
  "required": [
    "cd_sistema",
    "sigla",
    "intencao",
    "relato"
  ],
  "title": "NovaEntrevista",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sos-ia/NovaEntrevista.schema.json",
  "x-versao-contrato": "1.7.0"
}