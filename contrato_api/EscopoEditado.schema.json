{
  "$defs": {
    "Integracao": {
      "additionalProperties": false,
      "properties": {
        "sistema": {
          "title": "Sistema",
          "type": "string"
        },
        "sentido": {
          "pattern": "^(BUSCA|GRAVA|AMBOS)$",
          "title": "Sentido",
          "type": "string"
        },
        "descricao": {
          "title": "Descricao",
          "type": "string"
        },
        "origem": {
          "$ref": "#/$defs/Origem",
          "default": "usuario"
        }
      },
      "required": [
        "sistema",
        "sentido",
        "descricao"
      ],
      "title": "Integracao",
      "type": "object"
    },
    "Origem": {
      "description": "De onde veio um item do Escopo do Pedido (1.4.0). Só `usuario` é pedido dele; `inferido` é hipótese da análise, que o\nusuário confirma ou remove na tela, e que o estimador mostra à parte (não infla a contagem).",
      "enum": [
        "usuario",
        "documentacao",
        "inferido"
      ],
      "title": "Origem",
      "type": "string"
    },
    "RequisitoEditado": {
      "additionalProperties": false,
      "properties": {
        "segmento": {
          "description": "segmento de origem (Contrato.segmentos[].n); define o tipo e a natureza",
          "minimum": 1,
          "title": "Segmento",
          "type": "integer"
        },
        "descricao": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Descricao",
          "type": "string"
        },
        "criterio_aceite": {
          "default": "",
          "maxLength": 2000,
          "title": "Criterio Aceite",
          "type": "string"
        },
        "origem": {
          "$ref": "#/$defs/Origem",
          "default": "usuario",
          "description": "a do requisito do contrato de onde veio (o usuário pode ter editado)"
        },
        "n_contrato": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Contrato.requisitos[].n de onde veio; nulo = criado pelo usuário na tela. Requisito inferido do contrato que não volta aqui foi removido pelo usuário",
          "title": "N Contrato"
        }
      },
      "required": [
        "segmento",
        "descricao"
      ],
      "title": "RequisitoEditado",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Entrada de POST /entrevistas/{id}/confirmacao: o Escopo do Pedido como o usuário confirmou na tela.\nO tipo de cada requisito NÃO vem daqui: é sempre o do segmento de origem.",
  "properties": {
    "titulo": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Titulo",
      "type": "string"
    },
    "objetivo": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Objetivo",
      "type": "string"
    },
    "requisitos": {
      "items": {
        "$ref": "#/$defs/RequisitoEditado"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Requisitos",
      "type": "array"
    },
    "fora_escopo": {
      "items": {
        "maxLength": 1000,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Fora Escopo",
      "type": "array"
    },
    "duvidas": {
      "items": {
        "maxLength": 1000,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Duvidas",
      "type": "array"
    },
    "integracoes": {
      "items": {
        "$ref": "#/$defs/Integracao"
      },
      "maxItems": 20,
      "title": "Integracoes",
      "type": "array"
    },
    "cd_usuario": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "session(\"CD_USUARIO\") do SOS, para auditoria (nunca o nome)",
      "title": "Cd Usuario"
    },
    "candidatos_confirmados": {
      "description": "ids (CandidatoFuncionalidade.id) das funcionalidades que o usuário marcou como afetadas; só ids mostrados nesta entrevista (1.5.0: a tela do usuário não manda mais; fica para a Sustentação)",
      "items": {
        "type": "integer"
      },
      "maxItems": 5,
      "title": "Candidatos Confirmados",
      "type": "array"
    },
    "documentos_lidos": {
      "description": "1.5.0: Documento.pagina das páginas que o usuário abriu ou marcou como 'é isto que eu uso'; só páginas de EstadoEntrevista.documentos",
      "items": {
        "maxLength": 300,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Documentos Lidos",
      "type": "array"
    }
  },
  "required": [
    "titulo",
    "objetivo",
    "requisitos"
  ],
  "title": "EscopoEditado",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sos-ia/EscopoEditado.schema.json",
  "x-versao-contrato": "1.5.4"
}