  "components": {
    "schemas": {
      "CandidatoFuncionalidade": {
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "tipo_ifpug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tipo Ifpug"
          },
          "pagina_wiki": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pagina Wiki"
          },
          "trecho": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trecho"
          },
          "similaridade": {
            "type": "number",
            "title": "Similaridade"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome",
          "similaridade"
        ],
        "title": "CandidatoFuncionalidade"
      },
      "Contrato": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "versao_contrato": {
            "type": "string",
            "title": "Versao Contrato",
            "default": "1.1.0"
          },
          "titulo": {
            "type": "string",
            "maxLength": 200,
            "title": "Titulo"
          },
          "objetivo": {
            "type": "string",
            "title": "Objetivo"
          },
          "requisitos": {
            "items": {
              "$ref": "#/components/schemas/RequisitoContrato"
            },
            "type": "array",
            "title": "Requisitos"
          },
          "fora_escopo": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fora Escopo"
          },
          "duvidas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Duvidas"
          },
          "integracoes": {
            "items": {
              "$ref": "#/components/schemas/Integracao"
            },
            "type": "array",
            "title": "Integracoes"
          },
          "segmentos": {
            "items": {
              "$ref": "#/components/schemas/Segmento"
            },
            "type": "array",
            "title": "Segmentos"
          },
          "regra_documentada": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegraDocumentada"
              },
              {
                "type": "null"
              }
            ],
            "description": "trecho a anexar ao chamado quando aceita"
          },
          "decisao_regra": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisaoRegra"
              },
              {
                "type": "null"
              }
            ]
          },
          "nota": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Nota"
          },
          "faltando": {
            "items": {
              "$ref": "#/components/schemas/SlotFaltando"
            },
            "type": "array",
            "title": "Faltando",
            "description": "inclui o slot 'decisao_regra' enquanto a regra documentada estiver sem decisão"
          },
          "pode_confirmar": {
            "type": "boolean",
            "title": "Pode Confirmar",
            "description": "false enquanto houver slot obrigatório faltando"
          },
          "analise_ia": {
            "type": "boolean",
            "title": "Analise Ia"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "titulo",
          "objetivo",
          "requisitos",
          "fora_escopo",
          "duvidas",
          "integracoes",
          "segmentos",
          "nota",
          "faltando",
          "pode_confirmar",
          "analise_ia"
        ],
        "title": "Contrato",
        "description": "Resposta de POST /entrevistas/{id}/contrato. O usuário edita no SOS; confirmarAbertura.asp revalida os slots."
      },
      "DecisaoRegra": {
        "type": "string",
        "enum": [
          "ACEITA",
          "RECUSADA"
        ],
        "title": "DecisaoRegra",
        "description": "Escolha do usuário diante da regra documentada (o segmento fica CORRETIVO até ele decidir)."
      },
      "DecisaoRegraDocumentada": {
        "properties": {
          "aceita": {
            "type": "boolean",
            "title": "Aceita",
            "description": "true = o comportamento segue a regra e o usuário quer mudá-la (vira evolutivo); false = o usuário mantém que é defeito"
          },
          "comentario": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comentario",
            "description": "por que discorda, ou o que quer mudar na regra"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "aceita"
        ],
        "title": "DecisaoRegraDocumentada",
        "description": "Entrada de POST /entrevistas/{id}/regra."
      },
      "Erro": {
        "properties": {
          "erro": {
            "type": "string",
            "title": "Erro"
          },
          "detalhe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detalhe"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "erro"
        ],
        "title": "Erro"
      },
      "EstadoEntrevista": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "versao_contrato": {
            "type": "string",
            "title": "Versao Contrato",
            "default": "1.1.0"
          },
          "rodada": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Rodada",
            "description": "rodada atual de perguntas (máx. 2; 3 = encerrada)"
          },
          "pronto": {
            "type": "boolean",
            "title": "Pronto",
            "description": "true: não há mais perguntas; chamar POST /contrato"
          },
          "segmentos": {
            "items": {
              "$ref": "#/components/schemas/Segmento"
            },
            "type": "array",
            "title": "Segmentos"
          },
          "candidatos_funcionalidade": {
            "items": {
              "$ref": "#/components/schemas/CandidatoFuncionalidade"
            },
            "type": "array",
            "title": "Candidatos Funcionalidade"
          },
          "regra_documentada": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RegraDocumentada"
              },
              {
                "type": "null"
              }
            ]
          },
          "decisao_regra": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DecisaoRegra"
              },
              {
                "type": "null"
              }
            ],
            "description": "null com regra_documentada presente = o SOS deve perguntar ao usuário e chamar POST /entrevistas/{id}/regra"
          },
          "perguntas": {
            "items": {
              "$ref": "#/components/schemas/Pergunta"
            },
            "type": "array",
            "title": "Perguntas"
          },
          "nota": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Nota",
            "description": "medidor de qualidade do pedido"
          },
          "dicas_medidor": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dicas Medidor"
          },
          "analise_ia": {
            "type": "boolean",
            "title": "Analise Ia",
            "description": "false quando a resposta veio do roteiro fixo (sem IA)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "rodada",
          "pronto",
          "segmentos",
          "nota",
          "analise_ia"
        ],
        "title": "EstadoEntrevista",
        "description": "Resposta de POST /entrevistas, POST /entrevistas/{id}/respostas e GET /entrevistas/{id}."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Imagem": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 200,
            "title": "Nome"
          },
          "mime": {
            "type": "string",
            "pattern": "^image/(png|jpeg|gif|bmp|webp)$",
            "title": "Mime"
          },
          "base64": {
            "type": "string",
            "maxLength": 7000000,
            "title": "Base64",
            "description": "conteúdo da imagem em base64 (sem o prefixo data:)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome",
          "mime",
          "base64"
        ],
        "title": "Imagem"
      },
      "Integracao": {
        "properties": {
          "sistema": {
            "type": "string",
            "title": "Sistema"
          },
          "sentido": {
            "type": "string",
            "pattern": "^(BUSCA|GRAVA|AMBOS)$",
            "title": "Sentido"
          },
          "descricao": {
            "type": "string",
            "title": "Descricao"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sistema",
          "sentido",
          "descricao"
        ],
        "title": "Integracao"
      },
      "Intencao": {
        "type": "string",
        "enum": [
          "PAROU_DE_FUNCIONAR",
          "MUDAR_EXISTENTE",
          "ALGO_NOVO"
        ],
        "title": "Intencao",
        "description": "Opção do cardápio escolhida pelo usuário (a garantia não passa pela IA)."
      },
      "NovaEntrevista": {
        "properties": {
          "cd_sistema": {
            "type": "integer",
            "title": "Cd Sistema",
            "description": "CD_SISTEMA do SOS"
          },
          "sigla": {
            "type": "string",
            "maxLength": 40,
            "title": "Sigla",
            "description": "sigla do sistema (ex.: GAI)"
          },
          "intencao": {
            "$ref": "#/components/schemas/Intencao"
          },
          "relato": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Relato",
            "description": "relato livre do usuário"
          },
          "imagens": {
            "items": {
              "$ref": "#/components/schemas/Imagem"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Imagens"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "cd_sistema",
          "sigla",
          "intencao",
          "relato"
        ],
        "title": "NovaEntrevista"
      },
      "Pergunta": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "segmento": {
            "type": "integer",
            "title": "Segmento"
          },
          "slot": {
            "type": "string",
            "title": "Slot",
            "description": "código do slot que a resposta preenche ('gatilho' quando é pergunta de complexidade oculta)"
          },
          "texto": {
            "type": "string",
            "title": "Texto"
          },
          "dica": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dica"
