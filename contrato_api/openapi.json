    "/entrevistas/{eid}/regra": {
      "post": {
        "summary": "Decidir Regra",
        "description": "O usuário decide se o comportamento segue a regra documentada (aceita → evolutivo) ou se é defeito (recusa → corretivo).\n409 se a entrevista não tem regra documentada ou já foi decidida.",
