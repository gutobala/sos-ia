# Copie para .env e preencha. O .env nunca vai para o git.
# 1 = motor mock (sem LLM); 0 = motor real
SOSIA_MOCK=1
# token compartilhado com o proxy do SOS (cabeçalho X-SOSIA-Token); vazio no mock = "mock"
SOSIA_TOKEN=
SOSIA_API_PORTA=8010
SOSIA_DB_PORTA=5434
SOSIA_DB_SENHA=sosia_local
# banco da aplicação (entrevistas e Escopo do Pedido confirmado; volume externo sosia_app_pgdata)
SOSIA_APP_DB_PORTA=5435
SOSIA_APP_DB_SENHA=sosia_app_local
# openai (testes, chave pessoal) | azure (produção, contrato)
SOSIA_LLM=openai
# azure = text-embedding-3-large pela API (padrão; ganhou no catálogo) | e5 = modelo local
SOSIA_EMB=azure
# local (obrigatório fora da Azure) | contrato (só com SOSIA_LLM=azure e aprovação da Segurança)
# | teste (texto anonimizado, imagens originais; só testes controlados com imagens SEM dado pessoal)
SOSIA_PII_MODO=local
# resolução das imagens enviadas ao LLM: high (lê melhor telas, mais tokens) | low | auto
SOSIA_IMAGEM_DETALHE=high
# aquecimento da busca (pg_prewarm + busca de mentira) na subida e a cada N minutos; 0 desliga
SOSIA_AQUECER_MIN=30
# memória do Postgres do núcleo (o índice da wiki no 3-large tem 317 MB)
SOSIA_DB_SHARED_BUFFERS=1GB

# Modelos por papel (mesmos nomes de deployment do ANIA no contrato Azure)
# entrevista (perguntas, slots, contrato)
SOSIA_MODELO_CHAT=gpt-5.4-mini
# decomposição (Fase 2)
SOSIA_MODELO_RACIOCINIO=gpt-5.4
# prévia de PF (Fase 3): validado no holdout; gpt-5.4 superconta com o prompt atual
SOSIA_MODELO_PREVIA=gpt-4.1
# anonimização por LLM na ingestão (como o ANIA), só no modo contrato
SOSIA_MODELO_ANONIMIZACAO=gpt-5.4-mini
SOSIA_MODELO_EMBEDDING=text-embedding-3-large
# modelos 5.x: esforço de raciocínio da entrevista
SOSIA_REASONING_EFFORT=low
SOSIA_MAX_TOKENS=6000

OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
